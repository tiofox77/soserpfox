# AS PASTAS DAS EMPRESAS SÓ SERVEM FICHEIROS, NUNCA OS EXECUTAM.
#
# Segunda tranca (a primeira está em public/.htaccess): mesmo que um .php
# chegue aqui por um carregamento, não corre e não se descarrega.
<FilesMatch "\.(?i:php[0-9]?|phtml|phar|phps|pht|pl|py|cgi|sh|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# O tipo é o que o servidor diz, e um SVG não corre scripts: um «GIF» com HTML
# dentro não pode ser lido pelo browser como página.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    <FilesMatch "\.(?i:svgz?)$">
        Header set Content-Security-Policy "default-src 'none'; img-src data:; style-src 'unsafe-inline'; sandbox"
    </FilesMatch>
</IfModule>