{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "pwa:bancada": "php artisan bancada:pwa",
        "pwa:limpar": "php artisan bancada:pwa --limpar",
        "pwa:test": "playwright test --project=pwa",
        "pwa:test:ver": "playwright test --project=pwa --headed",
        "pwa:relatorio": "playwright show-report",
        "pwa:test:apache": "node scripts/pwa-test-apache.mjs",
        "react:build": "vite build --config vite.react.config.js && vite build --config vite.pwa.config.js && npm run css:publico",
        "css:publico": "node node_modules/tailwindcss3/lib/cli.js -c tailwind.publico.config.cjs -i resources/css/publico.css -o public/css/publico.css --minify",
        "react:dev": "vite build --config vite.react.config.js --watch",
        "react:tipos": "tsc --noEmit",
        "react:test": "vitest run",
        "react:test:browser": "node scripts/react-test-browser.mjs",
        "pwa:build": "vite build --config vite.pwa.config.js",
        "pwa:dev": "vite build --config vite.pwa.config.js --watch",
        "pwa:test:sw": "node --test tests/pwa/"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@popperjs/core": "^2.11.6",
        "@tailwindcss/vite": "^4.0.0",
        "@tanstack/react-query": "^5.102.8",
        "@tanstack/react-table": "^9.2.4",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^5.2.0",
        "axios": "^1.11.0",
        "bootstrap": "^5.2.3",
        "concurrently": "^9.0.1",
        "fake-indexeddb": "6.2.5",
        "jsdom": "^29.1.1",
        "jsqr": "^1.4.0",
        "laravel-vite-plugin": "^2.0.0",
        "pngjs": "^7.0.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "sass": "^1.56.1",
        "tailwindcss": "^4.0.0",
        "tailwindcss3": "npm:tailwindcss@^3.4.17",
        "typescript": "^7.0.2",
        "vite": "^7.0.7",
        "vitest": "^4.1.11",
        "ws": "^8.21.3"
    },
    "dependencies": {
        "@tiptap/extension-table": "^3.31.3",
        "@tiptap/extension-text-align": "^3.31.3",
        "@tiptap/pm": "^3.31.3",
        "@tiptap/react": "^3.31.3",
        "@tiptap/starter-kit": "^3.31.3",
        "dexie": "4.0.10"
    }
}
